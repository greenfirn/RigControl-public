# Template for rigcontrol-ws/.env - copy to .env and fill in the
# CHANGE_ME values. Never commit the real .env (it's already in
# .gitignore). Only needed if you run rigcontrol_dashboard_server.py
# standalone outside docker-compose (e.g. the Windows variant); the Pi
# deployment gets these from the top-level ha-docker/.env instead.

# MQTT Configuration
MQTT_MODE=local  # local, pi, or aws
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=CHANGE_ME

# AWS MQTT (if MQTT_MODE=aws)
AWS_MQTT_HOST=CHANGE_ME.iot.us-east-1.amazonaws.com
AWS_MQTT_PORT=8883
AWS_MQTT_CERT=/certs/device.pem.crt
AWS_MQTT_KEY=/certs/private.pem.key
AWS_MQTT_CA=/certs/AmazonRootCA1.pem

# API Configuration
API_BIND=0.0.0.0
API_PORT=8765
BASE_PATH=
MAX_WS_CONNECTIONS=5

# Timing Configuration
BROADCAST_INTERVAL=10
OFFLINE_PING_INTERVAL=30
OFFLINE_THRESHOLD=90
HISTORY_DAYS=14

# Database Configuration
USE_AWS_DB=false
AWS_REGION=us-east-1

# Notification Settings
EMAIL_ENABLED=false
SMS_PRIMARY_ENABLED=true
SMS_SECONDARY_ENABLED=false

# Gmail SMTP Configuration
GMAIL_USERNAME=your-email@gmail.com
# Gmail App Password (not your regular Gmail password) - generate at
# https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=CHANGE_ME
EMAIL_RECIPIENTS=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Twilio Configuration
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
PRIMARY_SMS_NUMBER=+1XXXXXXXXXX
SECONDARY_SMS_NUMBER=+1XXXXXXXXXX
