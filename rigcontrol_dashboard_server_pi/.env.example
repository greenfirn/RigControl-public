# Template for ~/ha-docker/.env - copy to .env and fill in the CHANGE_ME
# values. Never commit the real .env (it's already in .gitignore).

# Timezone
TZ=America/Toronto

# Caddy
CADDY_DOMAIN=yourdomain.duckdns.org
CADDY_TLS_EMAIL=your-email@example.com
CADDY_AUTH_USER=admin
# bcrypt hash of your basic-auth password - generate with:
#   docker run --rm caddy caddy hash-password
CADDY_AUTH_HASH=CHANGE_ME

# Update Intervals
DUCKDNS_INTERVAL=300

# DuckDNS Configuration
DUCKDNS_TOKEN=CHANGE_ME
DUCKDNS_SUBDOMAINS=yoursubdomain

# MQTT Configuration
MQTT_TOPIC_FILTER=rigcontrol/+/+
USE_AWS_DB=false
MQTT_MODE=pi

API_BIND=0.0.0.0
API_PORT=8765

HISTORY_DAYS=7

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=CHANGE_ME

AWS_MQTT_HOST=CHANGE_ME.iot.us-east-1.amazonaws.com
AWS_MQTT_PORT=8883

AWS_MQTT_CA_FILENAME=AmazonRootCA1.pem
AWS_MQTT_CERT_FILENAME=device.pem.crt
AWS_MQTT_KEY_FILENAME=private.pem.key

OFFLINE_PING_INTERVAL=3600
OFFLINE_THRESHOLD=3600
BROADCAST_INTERVAL=10

TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
PRIMARY_SMS_NUMBER=+1XXXXXXXXXX
SECONDARY_SMS_NUMBER=+1XXXXXXXXXX
GMAIL_USERNAME=your-email@gmail.com
# Gmail App Password (not your regular Gmail password) - generate at
# https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=CHANGE_ME
EMAIL_RECIPIENTS=your-email@gmail.com

# Remote Unlock / View-Only Mode
# See 2FA.md for the full security explanation of each of these.

# Trust X-Forwarded-For from the proxy directly in front of this server
# (Caddy) to tell LAN vs remote clients apart. Only enable this if you
# know exactly how many trusted proxy hops sit between clients and this
# server - see 2FA.md's "header spoofing" section before touching this.
TRUST_PROXY_HEADERS=true

# Number of trusted reverse proxies in front of this server, each of
# which appends (not overwrites) its own peer address to
# X-Forwarded-For. Caddy alone = 1 (this setup, default). If you ever
# add a tunnel/CDN in front of Caddy (Cloudflare, ngrok, etc.), bump
# this to 2 - see 2FA.md.
TRUSTED_PROXY_HOPS=1

# If true, prefer Cloudflare's CF-Connecting-IP header over counting
# X-Forwarded-For hops. Only enable if Cloudflare is confirmed to be
# the ONLY way to reach this server (origin firewalled to Cloudflare,
# or a Cloudflare Tunnel with no other ingress) - see 2FA.md. Leave
# false for a plain Caddy + DuckDNS setup like this one.
TRUST_CLOUDFLARE=false

# How long a requested unlock code stays valid before it expires
UNLOCK_CODE_TTL_SECONDS=600

# Minimum seconds between unlock code requests (global, not per-client -
# see 2FA.md for why this is intentional). Also the cooldown applied to
# wrong-email guesses, so don't set this too low.
UNLOCK_CODE_COOLDOWN_SECONDS=60

# How long a successful unlock lasts on that browser before it has to
# unlock again (12 hours default)
UNLOCK_TOKEN_TTL_SECONDS=43200

# Name of the cookie set on successful unlock - only worth changing if
# it collides with something else on the same domain
UNLOCK_COOKIE_NAME=rigcontrol_unlock

# Second, per-IP layer on top of UNLOCK_CODE_COOLDOWN_SECONDS above: at
# most this many unlock attempts (request-code + verify-code combined,
# success or failure) from the same IP within the window below. Doesn't
# replace the global cooldown's protection and is just as bypassable by
# an attacker rotating IPs - see 2FA.md.
UNLOCK_MAX_ATTEMPTS_PER_IP=3

# Window the above count applies over, in seconds (default 24h)
UNLOCK_ATTEMPTS_WINDOW_SECONDS=86400
